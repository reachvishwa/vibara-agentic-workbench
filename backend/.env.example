# Vibara Agentic Workbench configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1

# Chat history database (local SQLite by default)
DATABASE_URL=sqlite:///./chat.db

# Frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Filesystem MCP: comma-separated directories the agent may access
FILESYSTEM_MCP_ALLOWED_DIRS=

# Microsoft Access MCP
ACCESS_MCP_FOLDER=
ACCESS_MCP_SERVER_PATH=

# DuckDB MCP
DUCKDB_MCP_DB_PATH=:memory:

# Sandboxed Bash tool
BASH_TOOL_WORKDIR=
BASH_TOOL_ALLOWED_COMMANDS=git,python,pip,node,npm,npx,dir,type,findstr,where,echo,cd
BASH_TOOL_TIMEOUT_SECONDS=30

# Tavily web search
TAVILY_API_KEY=

# Optional: local Power BI Modeling MCP executable
POWERBI_MCP_PATH=
